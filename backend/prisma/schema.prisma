// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  //url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  nome String
  email String
  senha String
  CPF String
  CEP String
}

model Books {
  id Int @id @default(autoincrement())
  nome String
  valor Float
  autor String 
  ano Int 
  quantidade Int
  isAvailable Boolean
}

model Pagamento {
  id Int @id @default(autoincrement())
  nome String
}