generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PaymentMethod {
  CREDITO
  DEBITO
  PIX
  BOLETO
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_EM_ANALISE
  PAGO
  EM_SEPARACAO
  ENVIADO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  CPF          String?       @unique
  passwordHash String
  role         Role          @default(USER)
  address      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cartItems    CartItem[]
  favorites    Favorite[]
  paymentCards PaymentCard[]
  orders       Order[]
  ratings      BookRating[]
  sessions     Session[]
}

model Book {
  id          Int         @id @default(autoincrement())
  name        String
  autor       String
  year        Int
  price       Float
  quantity    Int         @default(0)
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  favorites   Favorite[]
  orderItems  OrderItem[]
  ratings     BookRating[]
}

model BookRating {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model PaymentCard {
  id             Int      @id @default(autoincrement())
  userId         Int
  type           String
  holderName     String
  brand          String
  lastFourDigits String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  paymentMethod PaymentMethod
  subtotal      Float
  discount      Float         @default(0)
  total         Float
  paymentReference String?
  status        OrderStatus   @default(AGUARDANDO_PAGAMENTO)
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  bookId    Int
  quantity  Int
  unitPrice Float
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book      Book  @relation(fields: [bookId], references: [id])
}
